# Copy to .env and fill in. Never commit .env.
# Every value here is optional except one API key: the defaults in
# src/config.py match this file.

# --- Credentials (at least one required) ---------------------------------
# Free, no credit card: https://console.groq.com
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Generation -----------------------------------------------------------
LLM_PROVIDER=groq
# Leave blank to use the provider default (see DEFAULT_MODELS in src/config.py)
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4

# Four-stage pipeline: higher quality in principle, several times the cost.
USE_MULTI_AGENT=true
USE_CITATIONS=true
USE_SMART_ROUTING=true

# --- Ingestion ------------------------------------------------------------
PDF_METHOD=pymupdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_PDF_SIZE_MB=50

# --- Embeddings and storage -----------------------------------------------
# Changing this after indexing requires re-ingesting: the stored vectors
# have a fixed dimension and the app refuses to mix models.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DB_PATH=./data/chroma_db
COLLECTION_NAME=research_papers

# --- Retrieval ------------------------------------------------------------
# Tuned on BEIR/SciFact by sweeping 0.0-1.0 over 300 queries; 0.5/0.5 peaked.
# The old 0.7/0.3 default came from a tutorial and cost ~1 nDCG point.
SEMANTIC_WEIGHT=0.5
KEYWORD_WEIGHT=0.5

# How the dense and BM25 result lists are merged.
#   weighted = normalise scores, then weighted sum (keeps confidence)
#   rrf      = fuse rank positions, ignore scores (scale-free, no normaliser)
FUSION_METHOD=weighted
# Only used by FUSION_METHOD=weighted. One of: minmax | sum | none
NORMALISATION=minmax
# Only used by FUSION_METHOD=rrf. 60 is the standard constant.
RRF_K=60
TOP_K_RETRIEVE=50
TOP_K_RERANK=10
MAX_CONTEXT_TOKENS=4000

# Absolute relevance floor (raw cosine similarity, before normalisation).
# Below this the system refuses to answer rather than passing weak context to
# the LLM. Raise to refuse more readily. Under-measured -- see EVALUATION.md.
MIN_SEMANTIC_SIMILARITY=0.40

# Off by default on measured evidence: on SciFact the cross-encoder cost 28x
# the latency for +0.75 nDCG while *lowering* Recall@5. Turn it on only if you
# can measure that it helps on your own corpus. See docs/EVALUATION.md.
USE_RERANKING=false

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
# plain | json
LOG_FORMAT=plain
