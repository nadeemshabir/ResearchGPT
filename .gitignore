# Secrets
.env
.env.local
.env.*.local

# Virtual environments
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
.eggs/
*.egg-info/

# Tooling caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Model weights
models/

# Local data. The vector store is a build artifact, rebuilt by re-ingesting,
# so it is not versioned. These paths are scoped deliberately: the previous
# blanket `*.bin` / `*.sqlite3` patterns were broad enough to silently hide
# legitimate files anywhere in the tree.
data/chroma_db/
data/raw/*.pdf
!data/raw/.gitkeep

# The BEIR/SciFact index, ~75 MB, rebuilt automatically by `make eval`.
data/eval_chroma/

# Evaluation evidence: the JSON results are committed on purpose -- they are
# what docs/EVALUATION.md cites. The console logs are not: they are mostly
# progress-bar output and add tens of megabytes over time.
eval/results/*.log

# Saved chat transcripts
chat_history_*.txt

# Frontend build output and dependencies. The bundle is produced by
# `npm run build` (and by the Dockerfile), so committing it would mean two
# sources of truth for the same files.
node_modules/
static/
*.tsbuildinfo
