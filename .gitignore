# Secrets
.env
.env.local
.env.*.local

# Virtual environments
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
.eggs/
*.egg-info/

# Tooling caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Model weights
models/

# Local data: never committed. Everything under data/ is rebuilt or
# re-downloaded -- the vector stores by re-ingesting, the evaluation PDFs by
# `make corpus`, uploads by uploading. The folders are created when needed.
data/

# Evaluation output. Runs are written here by `make eval*` and stay local.
# One run is committed: eval/data/human_grades.json was graded against it, and
# `make eval-calibrate` needs it to compare those grades with the LLM judge.
eval/results/*
!eval/results/generation-single-shot-20260805-161415.json

# Personal working notes, kept locally but not on GitHub.
/plan.md
/walkthrough.md

# Saved chat transcripts
chat_history_*.txt

# Frontend build output and dependencies. The bundle is produced by
# `npm run build` (and by the Dockerfile), so committing it would mean two
# sources of truth for the same files.
node_modules/
static/
*.tsbuildinfo
