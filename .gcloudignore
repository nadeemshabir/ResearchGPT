# What Cloud Build uploads. Kept in step with .dockerignore -- the build
# context should be the same wherever it runs, or a Cloud Build failure will
# not reproduce locally.
#
# Note: unlike .dockerignore, this file also controls what is *uploaded*, so
# excluding large directories here saves upload time on every deploy.

.git/
.gitignore
.github/

# Build outputs, regenerated in-image
static/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# The vector store is built during the image build from the fetched corpus.
# Uploading a local one would ship whatever happened to be on this machine.
data/chroma_db/
data/eval_chroma/
data/raw/*.pdf
data/processed/

# Secrets. The key comes from Secret Manager at runtime, never from the image.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed at runtime
test/
eval/
docs/
plan.md
Makefile
requirements-dev.txt
.idea/
.vscode/
