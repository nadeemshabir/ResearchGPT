# What Cloud Build uploads. Kept in step with .dockerignore -- the build
# context should be the same wherever it runs, or a Cloud Build failure will
# not reproduce locally.
#
# Note: unlike .dockerignore, this file also controls what is *uploaded*, so
# excluding large directories here saves upload time on every deploy.

.git/
.gitignore
.github/

# Build outputs, regenerated in-image
static/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# No local data goes into the image. The deployment's vector store is remote
# and its PDFs live in a bucket; anything under data/ here is a developer's
# own corpus, their uploads, or an evaluation store. Shipping any of it would
# put one machine's papers in front of every user -- which is exactly the bug
# that baking the corpus into the image created.
data/

# Secrets. The key comes from Secret Manager at runtime, never from the image.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The HuggingFace model cache: ~4GB of downloaded weights. Uploading it to
# Cloud Build timed out the CLI before a build could even start, and the image
# downloads its own copy of the model anyway.
.cache/
models/

# Not needed at runtime
test/
eval/
Makefile
requirements-dev.txt
.idea/
.vscode/
