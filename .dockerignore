# Keep the build context small and the image reproducible.
#
# Anything the build produces itself is excluded, so a stale local artifact can
# never end up baked into an image and silently differ from a clean CI build.

# Build outputs, regenerated in-image
static/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# The vector store is built during `docker build` from the fetched corpus.
# Copying a local one in would ship whatever happened to be on the developer's
# machine, including papers that are not in scripts/fetch_corpus.py.
data/chroma_db/
data/eval_chroma/
data/raw/*.pdf
data/processed/

# Secrets. .env is gitignored too, but a build context is a second way to leak
# one into an image layer.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The HuggingFace model cache. ~4GB of downloaded weights, and the single
# largest thing in the tree by two orders of magnitude. The image downloads its
# own copy of the embedding model, so shipping this one to the daemon achieved
# nothing except making every build slow.
.cache/
models/

# Not needed at runtime. Tests and evaluation are CI's job, not the image's.
test/
eval/
docs/
.github/
.git/
.gitignore
plan.md
Makefile
requirements-dev.txt

# Editors
.idea/
.vscode/
